# Google Gemini API key (free tier) for AI summary/tags/pros-cons.
# Get one at https://aistudio.google.com/apikey
# Without it, the app still works but shows no AI summary/tags/pros-cons.
GEMINI_API_KEY=

# Optional: Google Books API key for higher rate limits.
# Without it, Google Books lookups still work, just with stricter rate limits.
GOOGLE_BOOKS_API_KEY=
